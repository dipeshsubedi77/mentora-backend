# ============================================================
# Mentora Backend — LOCAL DEVELOPMENT Environment
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env (with real secrets) to git.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=Mentora AI Learning Companion
ENVIRONMENT=development
DEBUG=True

# ── API ─────────────────────────────────────────────────────
API_PREFIX=/api/v1
API_VERSION=v1

# ── Server ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=True

# ── Database ─────────────────────────────────────────────────
# Option A - Local PostgreSQL (Docker):
# DATABASE_URL=postgresql://mentora:mentora123@localhost:5432/mentora
# Option B - Neon Serverless (recommended for dev parity with production):
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication / JWT ─────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-do-not-use-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080

# ── Admin Registration ───────────────────────────────────────
ADMIN_SECRET_KEY=mentora-admin-secret-local

# ── AI API Keys ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Groq LLM ────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096
GROQ_MODEL_REQUEST_TOKEN_LIMIT=6000
GROQ_SYLLABUS_MAX_OUTPUT_TOKENS=2048
GROQ_SYLLABUS_MIN_INTERVAL_SECONDS=1.0
GROQ_SYLLABUS_MAX_INPUT_CHARS=8000

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chromadb

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,mp3,wav,doc,docx,txt

# ── AI Text Detection ────────────────────────────────────────
AI_DETECTION_LOW_THRESHOLD=0.30
AI_DETECTION_MEDIUM_THRESHOLD=0.60
AI_DETECTION_HIGH_THRESHOLD=0.80
AI_DETECTION_MIN_WORDS=40
AI_DETECTOR_MODEL_ENABLED=False
AI_DETECTOR_MODEL_NAME=
AI_DETECTOR_MODEL_BLEND_WEIGHT=0.3

# ── Email / SMTP ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Voice ────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base
TTS_ENGINE=pyttsx3

# ── Khalti ePayment (Sandbox) ────────────────────────────────
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_WEBSITE_URL=http://localhost:5173
KHALTI_RETURN_URL=http://localhost:5173/subscription
KHALTI_MOCK_SUCCESS=True
SUBSCRIPTION_PRICE_MONTHLY_PAISE=99900
SUBSCRIPTION_PRICE_YEARLY_PAISE=999900

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_METHODS=*

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_FREE_PER_MINUTE=10
RATE_LIMIT_SUBSCRIPTION_PER_MINUTE=30

# ── Quota System ─────────────────────────────────────────────
QUOTA_ENABLED=True
USER_RATE_LIMIT_ENABLED=True

# ── Subscription Plans ───────────────────────────────────────
SUBSCRIPTION_CURRENCY=NPR
SUBSCRIPTION_BILLING_PERIOD_DAYS=30

FREE_PRICE=0
FREE_AI_MESSAGES_PER_DAY=20
FREE_DOCUMENT_UPLOADS_PER_MONTH=5
FREE_AI_QUESTIONS_PER_MONTH=50
FREE_RAG_QUERIES_PER_MONTH=100
FREE_MAX_UPLOAD_SIZE_MB=10
FREE_CHAT_HISTORY_DAYS=30
FREE_LLM_MODEL=llama-3.1-8b-instant
FREE_PRIORITY_PROCESSING=False
FREE_ADVANCED_ANALYTICS=False
FREE_PERSONALIZED_LEARNING=False

PRO_PRICE=499
PRO_AI_MESSAGES_PER_DAY=200
PRO_DOCUMENT_UPLOADS_PER_MONTH=30
PRO_AI_QUESTIONS_PER_MONTH=1000
PRO_RAG_QUERIES_PER_MONTH=2000
PRO_MAX_UPLOAD_SIZE_MB=50
PRO_CHAT_HISTORY_DAYS=-1
PRO_LLM_MODEL=llama-3.1-8b-instant
PRO_PRIORITY_PROCESSING=True
PRO_ADVANCED_ANALYTICS=True
PRO_PERSONALIZED_LEARNING=False

PREMIUM_PRICE=999
PREMIUM_AI_MESSAGES_PER_DAY=1000
PREMIUM_DOCUMENT_UPLOADS_PER_MONTH=100
PREMIUM_AI_QUESTIONS_PER_MONTH=5000
PREMIUM_RAG_QUERIES_PER_MONTH=10000
PREMIUM_MAX_UPLOAD_SIZE_MB=100
PREMIUM_CHAT_HISTORY_DAYS=-1
PREMIUM_LLM_MODEL=llama-3.1-8b-instant
PREMIUM_PRIORITY_PROCESSING=True
PREMIUM_ADVANCED_ANALYTICS=True
PREMIUM_PERSONALIZED_LEARNING=True
